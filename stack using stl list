#include <iostream>
#include <list>
using namespace std;

int main() {
    list<int> st;      
    int choice, value;

    do {
    cout << "1.Push  2.Pop  3.Peek  4.Display  5.Exit"<< endl;
    cout << "Enter your choice: ";
    cin >> choice;
    switch (choice) {
    case 1:
   cout << "Enter value to push: ";
    cin >> value;
    st.push_back(value);
    cout << value << " pushed." << endl;
    break;
    case 2:
    if (st.empty()) {
    cout << "Stack Underflow! Stack is empty." << endl;
    } 
    else {
    cout << st.back() << " popped." << endl;
    st.pop_back();
   }
    break;
    case 3:
    if (st.empty()) {
    cout << "Stack is empty." << endl;
    } else {
    cout << "Top element: " << st.back() << endl;
    }
    break;
    case 4:
    if (st.empty()) {
    cout << "Stack is empty." << endl;
    } else {
    for (list<int>::reverse_iterator it = st.rbegin(); it != st.rend(); it++) {
    cout << *it << " ";
    }
    cout << endl;
    }
    break;
    case 5:
    cout << "Exiting the program" << endl;
    break;
    default:
    cout << "Invalid choice" << endl;
    }
    } while (choice != 5);

    return 0;
}
